@{
    ViewBag.Title = "Adjust Stock";
    var product = (InventoryManagement.Models.Product)ViewBag.Product;
}
<h2>Adjust stock - @product.Name</h2>
<form method="post">
  <input type="hidden" name="productId" value="@product.Id" />
  <div class="mb-3"><label>Change (+ for inbound, - for outbound)</label><input name="change" class="form-control" /></div>
  <div class="mb-3"><label>Note</label><input name="note" class="form-control" /></div>
  <button class="btn btn-primary">Save</button>
</form>

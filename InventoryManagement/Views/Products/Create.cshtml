@model InventoryManagement.Models.Product
@{ ViewBag.Title = "Create Product"; }
<h2>Create Product</h2>
<form method="post">
  <div class="mb-3"><label>Name</label><input name="Name" class="form-control" /></div>
  <div class="mb-3"><label>SKU</label><input name="SKU" class="form-control" /></div>
  <div class="mb-3"><label>Quantity</label><input type="number" name="Quantity" class="form-control" value="0" /></div>
  <div class="mb-3">
    <label>Warehouse</label>
    <select name="WarehouseId" class="form-select">
      <option value="">-- none --</option>
      @foreach(var w in (IEnumerable<InventoryManagement.Models.Warehouse>)ViewBag.Warehouses) {
        <option value="@w.Id">@w.Name</option>
      }
    </select>
  </div>
  <button class="btn btn-primary">Save</button>
</form>

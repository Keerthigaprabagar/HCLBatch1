@model InventoryManagement.Models.Product
@{ ViewBag.Title = "Edit Product"; }
<h2>Edit Product</h2>
<form method="post">
  <input type="hidden" name="Id" value="@Model.Id" />
  <div class="mb-3"><label>Name</label><input name="Name" class="form-control" value="@Model.Name" /></div>
  <div class="mb-3"><label>SKU</label><input name="SKU" class="form-control" value="@Model.SKU" /></div>
  <div class="mb-3"><label>Quantity</label><input type="number" name="Quantity" class="form-control" value="@Model.Quantity" /></div>
  <div class="mb-3">
    <label>Warehouse</label>
    <select name="WarehouseId" class="form-select">
      <option value="">-- none --</option>
      @foreach(var w in (IEnumerable<InventoryManagement.Models.Warehouse>)ViewBag.Warehouses) {
        <option value="@w.Id" @(w.Id==Model.WarehouseId? "selected" : "")>@w.Name</option>
      }
    </select>
  </div>
  <button class="btn btn-primary">Save</button>
</form>
